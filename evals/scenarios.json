{
  "version": 1,
  "placeholders": {
    "{tuesday}": "next Tuesday at least 2 days ahead (ISO date)",
    "{code}": "confirmation_code saved by an earlier step in the same scenario",
    "{key}": "a fixed idempotency key used within the scenario",
    "{token}": "confirmation_token saved by an earlier step in the same scenario",
    "{sunday}": "next Sunday (ISO date)"
  },
  "scenarios": [
    {
      "id": "success-faq-hours",
      "category": "success",
      "type": "message",
      "message": "What are your hours?",
      "expect_route": "faq",
      "expect_reply_contains": "Monday to Friday"
    },
    {
      "id": "success-faq-parking",
      "category": "success",
      "type": "message",
      "message": "Where are you and is there parking?",
      "expect_route": "faq",
      "expect_reply_contains": "parking"
    },
    {
      "id": "success-availability-via-text",
      "category": "success",
      "type": "message",
      "message": "Any cleaning times on {tuesday}?",
      "expect_route": "availability",
      "expect_reply_contains": "Open cleaning times"
    },
    {
      "id": "success-book-preview-then-confirm",
      "category": "success",
      "type": "api",
      "steps": [
        {
          "method": "POST",
          "path": "/api/appointments",
          "body": {
            "patient_name": "Eval Patient",
            "appointment_type": "cleaning",
            "date": "{tuesday}",
            "start_time": "10:00"
          },
          "expect_status": 200,
          "expect": {
            "status": "confirmation_required",
            "confirmation_code": null
          }
        },
        {
          "method": "POST",
          "path": "/api/appointments",
          "body": {
            "patient_name": "Eval Patient",
            "appointment_type": "cleaning",
            "date": "{tuesday}",
            "start_time": "10:00",
            "caller_confirms": true
          },
          "expect_status": 200,
          "expect": {
            "status": "booked"
          },
          "save": {
            "code": "confirmation_code"
          }
        }
      ]
    },
