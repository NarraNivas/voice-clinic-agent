    {
      "id": "robustness-blank-optional-token-is-a-preview",
      "category": "robustness",
      "type": "api",
      "steps": [
        {
          "method": "POST",
          "path": "/api/appointments",
          "body": {
            "patient_name": "Eval Patient",
            "appointment_type": "consultation",
            "date": "{tuesday}",
            "start_time": "15:30",
            "confirmation_token": "",
            "idempotency_key": ""
          },
          "expect_status": 200,
          "expect": {
            "status": "confirmation_required",
            "confirmation_code": null
          }
        }
      ]
    }
  ],
  "notes": {
    "caller_confirms": "Runner-only. The runner first sends the request with no token, which is the preview. It then sends the same body with the confirmation_token from that preview. This is how a caller says yes. The API never reads this key."
  }
}
