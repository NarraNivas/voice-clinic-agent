            "confirmation_code": "{code}",
            "patient_name": "Eval Patient",
            "new_date": "{tuesday}",
            "new_start_time": "14:00",
            "caller_confirms": true
          },
          "expect_status": 200,
          "expect": {
            "status": "rescheduled"
          }
        }
      ]
    },
