{
  "version": 1,
  "label": "synthetic regression fixture: reconstructed from an observed failure class; not a recorded call",
  "note": "Each case reproduces a failure class and checks the expected outcome. Cases are deterministic contract checks, not a benchmark of the live voice agent.",
  "workflows": [
    {
      "label": "synthetic regression fixture: reconstructed from an observed failure class; not a recorded call",
      "type": "api",
      "steps": [
        {
          "method": "POST",
          "path": "/api/appointments",
          "body": {
            "patient_name": "Workflow Caller",
            "appointment_type": "checkup",
            "date": "{tuesday}",
            "start_time": "03:30"
          },
          "expect_status": 422,
          "expect_error": "clinic_closed"
        }
      ],
      "id": "wf-canonical-0330-stays-closed",
      "category": "time",
      "description": "03:30 is a 24-hour time. It must not become 15:30."
    },
