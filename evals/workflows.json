    {
      "label": "synthetic regression fixture: reconstructed from an observed failure class; not a recorded call",
      "type": "api",
      "steps": [
        {
          "method": "POST",
          "path": "/api/appointments",
          "body": {
            "patient_name": "Workflow Caller",
            "appointment_type": "checkup",
            "date": "{tuesday}",
            "start_time": "10:00",
            "caller_confirms": true
          },
          "expect_status": 200,
          "expect": {
            "status": "booked"
          },
          "save": {
            "code": "confirmation_code"
          }
        },
        {
          "method": "POST",
          "path": "/api/appointments/cancel",
          "body": {
            "confirmation_code": "{code}",
            "patient_name": "Workflow Caller"
          },
          "expect_status": 200,
          "save": {
            "stale": "confirmation_token"
          }
        },
        {
          "method": "POST",
          "path": "/api/appointments/reschedule",
          "body": {
            "confirmation_code": "{code}",
            "patient_name": "Workflow Caller",
            "new_date": "{tuesday}",
            "new_start_time": "14:00",
            "caller_confirms": true
          },
          "expect_status": 200,
          "expect": {
            "status": "rescheduled"
          }
        },
        {
          "method": "POST",
          "path": "/api/appointments/cancel",
          "body": {
            "confirmation_code": "{code}",
            "patient_name": "Workflow Caller",
            "confirmation_token": "{stale}"
          },
          "expect_status": 409,
          "expect_error": "invalid_confirmation"
        }
      ],
      "id": "wf-stale-cancel-after-reschedule",
      "category": "revision",
      "description": "A cancel preview taken before a reschedule must not cancel the moved booking."
