# Copy this file to .env and fill in only what you need. Never commit .env.
# The app runs fully in local demo mode with every value left blank.
# Write KEY=value with NO space after the "=". The shell reads anything after a space as a command.
# The app does not read .env by itself. Load it first: set -a; . ../.env; set +a

# Shared secret for the voice agent's server tools (/tools/*). Required to enable those routes.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TOOL_SHARED_SECRET=

# Public agent ID from ElevenLabs (optional). Enables the voice widget on the demo page.
# Not secret, but anyone with it can start calls on your account. See docs/ELEVENLABS_SETUP.md.
ELEVENLABS_AGENT_ID=

# SQLite file location (optional). Defaults to backend/data/clinic.db.
CLINIC_DB_PATH=
